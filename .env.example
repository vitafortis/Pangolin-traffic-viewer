# Port the server listens on
PORT=8787
# Bind address. Keep 127.0.0.1 unless APP_PASSWORD is set.
HOST=127.0.0.1
# Where SQLite + GeoIP data live
DATA_DIR=./data
# 32+ char secret used to encrypt stored Pangolin API keys and sign session cookies. REQUIRED in production.
APP_SECRET=change-me-to-a-long-random-string
# If set, the UI/API require this password
APP_PASSWORD=
# Generate synthetic traffic (no Pangolin key needed)
DEMO=0
# How long to keep events locally (days)
RETENTION_DAYS=30
